---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import socialImage from '../../assets/og/projects.jpg';
import defaultProjectImage from '../../assets/projects/project-placeholder.png';
import { siteConfig } from '../../config/site';

const projects = siteConfig.projectsWhitelist;
const featuredNames = ['FX-Pulse', 'yannick-stock-checker', 'ShortYou'];
const featured = featuredNames.map(name => projects.find(project => project.name === name)!);
const remaining = projects.filter(project => !featuredNames.includes(project.name));
const categories = ['全部', ...new Set(remaining.map(project => project.category))];
const description = '把生活裡反覆遇到的麻煩，做成好用的工具。探索黑糖的網站服務、自動化工具與資料專案。';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: '作品',
  url: `${siteConfig.url}/projects/`, description,
  mainEntity: { '@type': 'ItemList', itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem', position: index + 1, name: project.title ?? project.name,
    url: `${siteConfig.url}/projects/${project.name.toLowerCase()}/`,
  })) },
};
---
<BaseLayout title="作品" description={description} currentPath="/projects/" image={socialImage.src} structuredData={structuredData} hasPointerGlow={false}>
  <div class="portfolio" data-pagefind-body>
    <header class="intro">
      <p class="eyebrow">SELECTED WORK / 黑糖的工具箱</p>
      <h1>從生活裡的麻煩，<br />做出一點<span>改變。</span></h1>
      <div class="intro-bottom"><p>寫些自己也會用的工具。<br />從查庫存、比匯率，到把每天的重複工作交給程式。</p><a href="#project-directory">看看另外 {remaining.length} 個作品 <span aria-hidden="true">↓</span></a></div>
    </header>
    <section aria-labelledby="featured-title" class="featured-section">
      <div class="section-heading"><h2 id="featured-title">精選作品</h2><span>先從這三個開始</span></div>
      <div class="featured-grid">
        {featured.map((project, index) => (
          <a class:list={['feature', { 'feature-lead': index === 0 }]} href={`/projects/${project.name.toLowerCase()}/`}>
            <div class="feature-image">
              {project.image && (typeof project.image === 'string' ? <img src={project.image} alt={`${project.title} 的介面截圖`} loading="lazy" /> :
                <Picture src={project.image} alt={`${project.title} 的介面截圖`} widths={[480, 800, 1280, 1600]} sizes={index === 0 ? '(max-width: 700px) calc(100vw - 40px), 1080px' : '(max-width: 700px) calc(100vw - 40px), 530px'} formats={['avif', 'webp']} loading={index === 0 ? 'eager' : 'lazy'} />)}
              <span class="feature-number" aria-hidden="true">0{index + 1}</span>
            </div>
            <div class="feature-caption"><div><p class="feature-meta">{project.category} <span aria-hidden="true">·</span> {project.period}</p><h3>{project.title ?? project.name}</h3><p>{project.summary}</p></div><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg></div>
          </a>
        ))}
      </div>
    </section>
    <section id="project-directory" aria-labelledby="directory-title" class="directory">
      <div class="section-heading"><h2 id="directory-title">還有這些小工具</h2><span>讓日常少一點重複</span></div>
      <div class="directory-controls">
        <div class="filters" role="group" aria-label="篩選其他作品" hidden>
          {categories.map((category, index) => <button type="button" data-category={category} aria-pressed={index === 0}>{category}</button>)}
        </div>
        <div class="view-switch" role="group" aria-label="作品檢視方式" hidden>
          <button type="button" data-view="list" aria-pressed="true">列表</button>
          <button type="button" data-view="cards" aria-pressed="false">卡片</button>
        </div>
      </div>
      <ul class="project-list">
        {remaining.map(project => (
          <li data-project-category={project.category}>
            <a href={`/projects/${project.name.toLowerCase()}/`}>
              <span class="row-meta">
                <span class="row-category">{project.category}</span>
                <span class="row-period">{project.period}</span>
              </span>
              <span class="row-media">
                {typeof project.image === 'string' ? <img src={project.image} data-fallback={defaultProjectImage.src} alt={`${project.title ?? project.name} 的專案畫面`} loading="lazy" decoding="async" onerror="this.onerror=null; this.src=this.dataset.fallback" /> :
                  <Picture src={project.image ?? defaultProjectImage} alt={`${project.title ?? project.name} 的專案畫面`} widths={[160, 240, 320]} sizes="(max-width: 700px) 96px, 112px" formats={['avif', 'webp']} loading="lazy" />}
              </span>
              <span class="row-copy">
                <h3>{project.title ?? project.name}</h3>
                <p>{project.summary}</p>
                {project.tags?.length ? <ul class="row-tags">{project.tags.slice(0, 3).map(tag => <li>{tag}</li>)}</ul> : null}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="filter-status" role="status" aria-live="polite"></p>
    </section>
  </div>
</BaseLayout>
<style>
  .portfolio { max-width: 1080px; margin: auto; padding: 8rem 1.25rem 5rem; }
  .eyebrow { color: rgb(var(--color-primary)); font-size: .75rem; letter-spacing: .15em; margin-bottom: 1.8rem; }
  h1 { font-size: clamp(2.2rem, 5.3vw, 4.1rem); font-weight: 700; line-height: 1.3; letter-spacing: -.035em; }
  h1 span { color: rgb(var(--color-primary)); }
  .intro-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-top: 2rem; }
  .intro-bottom p { color: rgb(var(--color-text-secondary)); line-height: 1.9; }
  .intro-bottom a { display: inline-flex; align-items: center; gap: 1rem; min-height: 44px; font-size: .875rem; border-bottom: 1px solid rgb(var(--color-primary)); }
  .featured-section { margin-top: 5rem; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .section-heading h2 { font-size: 1.1rem; font-weight: 600; }
  .section-heading > span { font-size: .8rem; color: rgb(var(--color-text-secondary)); }
  .featured-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; }
  .feature { min-width: 0; border-radius: 12px; }
  .feature-lead { grid-column: 1 / -1; }
  .feature-image { position: relative; overflow: hidden; border-radius: 12px; background: rgb(var(--color-primary) / .045); border: 1px solid rgba(255,255,255,.1); padding: 1.5rem; aspect-ratio: 1.6; display: flex; align-items: center; justify-content: center; }
  .feature-lead .feature-image { aspect-ratio: 2.1; padding: 2.5rem 4rem; }
  .feature-image :global(picture) { width: 100%; height: 100%; }
  .feature-image :global(img) { width: 100%; height: 100%; object-fit: contain; transition: transform .25s ease; }
  .feature:hover .feature-image :global(img) { transform: scale(1.025); }
  .feature-number { position: absolute; left: 1rem; top: .8rem; font-size: .7rem; color: rgb(var(--color-text-secondary)); }
  .feature-caption { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.2rem; }
  .feature-meta { margin: 0 0 .45rem; color: rgb(var(--color-primary)); font-size: .72rem; letter-spacing: .04em; }
  h3 { font-size: 1.15rem; line-height: 1.5; font-weight: 600; }
  .feature-caption p, .project-list p { margin-top: .4rem; font-size: .9rem; line-height: 1.7; color: rgb(var(--color-text-secondary)); }
  .feature-caption .feature-meta { margin-top: 0; color: rgb(var(--color-primary)); }
  .arrow { width: 1.35rem; height: 1.35rem; flex: 0 0 auto; color: rgb(var(--color-primary)); }
  .directory { margin-top: 5.5rem; scroll-margin-top: 6rem; }
  .directory-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .filters, .view-switch { display: flex; flex-wrap: wrap; gap: .5rem; }
  .filters[hidden], .view-switch[hidden], li[hidden] { display: none; }
  .filters button { min-height: 44px; padding: .5rem 1rem; border: 1px solid rgba(255,255,255,.14); border-radius: 6px; color: rgb(var(--color-text-secondary)); font-size: .85rem; cursor: pointer; }
  .filters button[aria-pressed="true"] { color: rgb(var(--color-primary)); background: rgb(var(--color-primary) / .1); border-color: rgb(var(--color-primary) / .45); }
  .view-switch { padding: .2rem; border: 1px solid rgba(255,255,255,.14); border-radius: 8px; }
  .view-switch button { min-height: 44px; padding: .35rem .7rem; border: 0; border-radius: 5px; color: rgb(var(--color-text-secondary)); background: transparent; font-size: .8rem; cursor: pointer; }
  .view-switch button[aria-pressed="true"] { color: rgb(var(--color-text)); background: rgb(var(--color-primary) / .14); }
  .project-list { padding: 0; list-style: none; }
  .project-list li { border-top: 1px solid rgba(255,255,255,.12); }
  .project-list li:last-child { border-bottom: 1px solid rgba(255,255,255,.12); }
  .project-list a { display: grid; grid-template-columns: 7rem 7rem minmax(0, 1fr); gap: 1.25rem; align-items: center; padding: 1rem .5rem; }
  .project-list a:hover h3, .feature:hover h3 { color: rgb(var(--color-primary)); }
  .row-meta { display: flex; min-width: 0; flex-direction: column; gap: .25rem; text-align: center; }
  .row-category, .row-period { font-size: .75rem; }
  .row-category { color: rgb(var(--color-text-secondary)); }
  .row-period { color: rgb(var(--color-primary)); }
  .row-media { position: relative; display: block; width: 7rem; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 8px; background: rgb(var(--color-primary) / .045); }
  .row-media :global(picture), .row-media :global(img) { display: block; width: 100%; height: 100%; }
  .row-media :global(img) { object-fit: contain; transition: transform .25s ease; }
  .project-list a:hover .row-media :global(img) { transform: scale(1.04); }
  .row-copy { min-width: 0; }
  .row-tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; padding: 0; margin: .7rem 0 0; list-style: none; }
  .row-tags li { max-width: 100%; padding: .18rem .45rem; border: 1px solid rgb(var(--color-primary) / .25); border-radius: 999px; color: rgb(var(--color-primary)); background: rgb(var(--color-primary) / .06); font-size: .65rem; line-height: 1.4; overflow-wrap: anywhere; }
  .filter-status { min-height: 1.5rem; margin-top: 1rem; font-size: .8rem; color: rgb(var(--color-text-secondary)); }
  .directory[data-view="cards"] .project-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .directory[data-view="cards"] .project-list li, .directory[data-view="cards"] .project-list li:last-child { border: 1px solid rgba(255,255,255,.12); border-radius: 10px; overflow: hidden; }
  .directory[data-view="cards"] .project-list a { grid-template-columns: 1fr; grid-template-rows: auto 1fr; gap: 1rem; height: 100%; padding: 0 1rem 1rem; }
  .directory[data-view="cards"] .row-meta { position: relative; z-index: 2; display: block; grid-column: 1 / -1; grid-row: 1; width: calc(100% + 2rem); height: 100%; margin-inline: -1rem; pointer-events: none; text-align: initial; }
  .directory[data-view="cards"] .row-category, .directory[data-view="cards"] .row-period { position: absolute; display: inline-flex; align-items: center; min-height: 1.5rem; max-width: calc(100% - 1.5rem); padding: .2rem .55rem; overflow: hidden; border: 1px solid rgb(var(--color-primary) / .42); border-radius: 999px; background: rgb(var(--color-bg-dark) / .78); color: rgb(var(--color-text-primary)); font-size: .7rem; line-height: 1.2; white-space: nowrap; text-overflow: ellipsis; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .directory[data-view="cards"] .row-category { top: .75rem; right: .75rem; min-height: 1.35rem; padding: .15rem .45rem; font-size: .65rem; }
  .directory[data-view="cards"] .row-period { bottom: .75rem; left: .75rem; color: rgb(var(--color-primary)); }
  .directory[data-view="cards"] .row-media { grid-column: 1 / -1; grid-row: 1; z-index: 1; width: calc(100% + 2rem); height: 12rem; margin-inline: -1rem; aspect-ratio: auto; border-width: 0 0 1px; border-radius: 0; }
  .directory[data-view="cards"] .row-media :global(img) { object-fit: contain; }
  .directory[data-view="cards"] .row-copy { grid-column: 1; grid-row: 2; align-self: start; }
  .directory[data-view="cards"] .row-copy p { margin-bottom: 0; }
  a:focus-visible, button:focus-visible { outline: 2px solid rgb(var(--color-primary)); outline-offset: 5px; }
  @media (max-width: 700px) {
    .portfolio { padding-top: 6rem; }
    .intro-bottom { display: block; }
    .intro-bottom a { margin-top: 1.5rem; }
    .featured-grid { grid-template-columns: 1fr; }
    .feature-lead .feature-image, .feature-image { aspect-ratio: 1.6; padding: 1rem; }
    .directory-controls { align-items: flex-start; flex-direction: column; }
    .filters button { padding-inline: .875rem; }
    .project-list a { grid-template-columns: 5.75rem minmax(0, 1fr); gap: .5rem .85rem; padding: 1rem 0; }
    .row-meta { grid-column: 1 / -1; flex-direction: row; justify-content: flex-start; gap: .5rem; text-align: left; }
    .row-media { width: 5.75rem; }
    .directory[data-view="cards"] .project-list { grid-template-columns: 1fr; }
    .directory[data-view="cards"] .project-list a { grid-template-columns: 1fr; padding: 0 1rem 1rem; }
    .section-heading > span { font-size: .75rem; }
    .featured-section, .directory { margin-top: 3.5rem; }
  }
  @media (max-width: 480px) {
    .view-switch { display: none; }
    .directory[data-view="cards"] .row-media { height: clamp(9rem, 40vw, 11rem); }
    .directory[data-view="cards"] .row-copy p { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  }
  @media (prefers-reduced-motion: reduce) { .feature-image :global(img), .row-media :global(img) { transition: none; } .feature:hover .feature-image :global(img), .project-list a:hover .row-media :global(img) { transform: none; } }
</style>
<script>
  const directory = document.querySelector<HTMLElement>('.directory');
  const filters = document.querySelector<HTMLElement>('.filters');
  const viewSwitch = document.querySelector<HTMLElement>('.view-switch');
  const viewButtons = viewSwitch?.querySelectorAll<HTMLButtonElement>('button') ?? [];
  const buttons = filters?.querySelectorAll<HTMLButtonElement>('button') ?? [];
  const rows = document.querySelectorAll<HTMLElement>('[data-project-category]');
  const status = document.querySelector<HTMLElement>('.filter-status');
  const mobileViewport = window.matchMedia('(max-width: 480px)');
  const setView = (view: 'list' | 'cards') => {
    if (!directory) return;
    directory.dataset.view = view;
    viewButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
  };

  setView(mobileViewport.matches ? 'cards' : 'list');
  mobileViewport.addEventListener('change', event => setView(event.matches ? 'cards' : 'list'));
  if (filters) filters.hidden = false;
  if (viewSwitch) viewSwitch.hidden = false;
  viewButtons.forEach(button => button.addEventListener('click', () => {
    const view = button.dataset.view;
    if (view !== 'list' && view !== 'cards') return;
    setView(view);
  }));
  buttons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.category;
    let count = 0;
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    rows.forEach(row => {
      row.hidden = category !== '全部' && row.dataset.projectCategory !== category;
      if (!row.hidden) count++;
    });
    if (status) status.textContent = count ? `顯示 ${count} 個作品` : '精選網站作品在上方，這裡目前沒有其他作品。';
  }));
</script>
