<script>
  // Mark the section currently being read in the sticky page nav: the last section whose top
  // has passed 40% of the viewport, or the final section once the page can't scroll further.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.page-nav a')];
  const sections = links.map(link => document.getElementById(link.hash.slice(1)));
  let frame = 0;
  const update = () => {
    frame = 0;
    const line = innerHeight * 0.4;
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    let current = 0;
    sections.forEach((section, index) => {
      if (section && section.getBoundingClientRect().top <= line) current = index;
    });
    if (atBottom) current = sections.length - 1;
    links.forEach((link, index) => {
      if (index === current) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };
  addEventListener('scroll', () => { frame ||= requestAnimationFrame(update); }, { passive: true });
  update();
</script>
