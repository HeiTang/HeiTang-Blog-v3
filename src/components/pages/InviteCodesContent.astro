---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInviteBrand, selectHeroCodes } from '../../data/invite-brands';
import { inviteCategories, getInviteCategory, getInviteSubcategory } from '../../data/invite-categories';
import socialImage from '../../assets/og/invite-codes.jpg';
import InviteCodeCard from '../invite-codes/InviteCodeCard.astro';
import { fetchInviteCodes, extractGroups } from '../../services/inviteCodes';
import { siteConfig } from '../../config/site';
import { copy } from '../../config/copy';
import { formatDate } from '../../utils/date';
import { getInviteSlug, getInviteShareDescription } from '../../data/invite-share';
import type { InviteCode, InviteCodesResponse } from '../../types/invite';

interface Props { data?: InviteCodesResponse; service?: InviteCode; }
const { data, service } = Astro.props;
const { codes: sourceCodes, updatedAt } = data ?? await fetchInviteCodes();
const codes = sourceCodes.map(code => ({ ...code, group: getInviteSubcategory(code) }));
const groupedCodes = Object.fromEntries(Object.keys(inviteCategories).map(category => [category, codes.filter(code => getInviteCategory(code) === category)]));
const sectionKeys = Object.keys(groupedCodes).filter(category => groupedCodes[category].length > 0);
const heroCodes = selectHeroCodes(codes);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.inviteCodes.title,
  description: copy.inviteCodes.description,
  url: `${siteConfig.url}/invite-codes/`,
};
---

<BaseLayout title={service ? `${service.title} 邀請碼與回饋` : copy.inviteCodes.title} description={service ? getInviteShareDescription(service) : copy.inviteCodes.description} currentPath="/invite-codes" image={service ? `/invite-codes/og/${getInviteSlug(service.title)}.png` : socialImage.src} structuredData={service ? undefined : structuredData} noindex={!!service} hasPointerGlow={false}>
  <article class="invite-directory" data-shared-service={service?.title} data-pagefind-body={service ? undefined : true} data-pagefind-ignore={service ? true : undefined}>
    <header class="page-intro">
      <p class="eyebrow">INVITE CODES / 黑糖的邀請碼清單</p>
      <div class="hero-layout">
        <h1>各種邀請碼，<br />收在<span>這裡。</span></h1>
        {heroCodes.length > 0 && <div class="pocket-art" role="group" aria-label="服務卡片，可左右拖曳或點選切換" data-pagefind-ignore>
          {heroCodes.map((code, index) => {
            const brand = getInviteBrand(code.title);
            return <button type="button" disabled class="pocket-ticket" aria-label={`將 ${code.title} 卡片帶到前面`} aria-pressed="false" style={`--ticket-color: ${brand.color}; --ticket-index: ${index}`}>
            <span class="ticket-brand">{brand.icon ? <img src={`/images/invite-brands/${brand.icon}.png`} alt="" width="32" height="32" /> : <span class="ticket-monogram">{code.title.slice(0, 2)}</span>}<span class="ticket-title">{code.title}</span><span class="ticket-arrow">↗</span></span>
            <span class="ticket-benefit">{code.user_benefit ?? code.description}</span>
            <span class="ticket-stub"><span>INVITE / {String(index + 1).padStart(2, '0')}</span><span class="ticket-barcode"></span></span>
          </button>;
          })}
        </div>}
      </div>
      <div class="intro-bottom">
        <p>{copy.inviteCodes.description}。<br />收錄不等於推薦，使用前請確認服務與活動條件。</p>
        <p class="updated-at">{copy.inviteCodes.lastUpdated}<br /><time datetime={updatedAt}>{formatDate(updatedAt)}</time></p>
      </div>
    </header>

    {codes.length === 0 ? (
      <div class="glass p-12 rounded-2xl text-center">
        <p class="text-[rgb(var(--color-text-secondary))] text-lg">{copy.inviteCodes.noData}</p>
        <p class="text-[rgb(var(--color-text-secondary))] text-sm mt-3">
          {import.meta.env.INVITE_CODES_API_URL
            ? copy.inviteCodes.loadError
            : '有新的服務邀請碼時，會更新在這裡。'}
        </p>
      </div>
    ) : (
      <>
        <div class="tag-tabs-wrapper" role="group" aria-label="邀請碼篩選" hidden>
          <button class="tag-tab active" data-tag="__all__" aria-pressed="true">
            {copy.inviteCodes.allFilter} <span data-count>{codes.length}</span>
          </button>
          <div class="tag-tabs-scroll" role="group" aria-label="服務分類">
            {sectionKeys.map(tag => (
              <button class="tag-tab" data-tag={tag} aria-pressed="false">
                {tag} <span data-count>{groupedCodes[tag].length}</span>
              </button>
            ))}
          </div>
          <button id="hide-expired-toggle" class="filter-btn" aria-label="只看有效" title="只看有效" aria-pressed="true" data-active="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16l-6 7v5l-4 3v-8z" /><path class="filter-check" d="m16 19 2 2 4-5" /></svg>
          </button>
        </div>
        <p id="filter-status" class="sr-only" role="status" hidden></p>
        {sectionKeys.map(category => (
          <div class="subcategory-tabs" data-parent-category={category} role="group" aria-label={`${category}子分類`} hidden>
            <button type="button" class="subcategory-tab active" data-subcategory="__all__" aria-pressed="true">不限</button>
            {extractGroups(groupedCodes[category]).map(subcategory => (
              <button type="button" class="subcategory-tab" data-subcategory={subcategory} aria-pressed="false">{subcategory} <span data-count>{groupedCodes[category].filter(code => code.group === subcategory).length}</span></button>
            ))}
          </div>
        ))}
        <div id="filter-empty" class="filter-empty" aria-labelledby="filter-empty-title" hidden>
          <span class="empty-art" aria-hidden="true"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5Z" /><path d="M9 5v14" stroke-dasharray="2 3" /><path d="M13 10h3m-3 4h2" /></svg></span>
          <h2 id="filter-empty-title">這個分類目前沒有有效邀請碼</h2>
          <p>過往收錄的服務還在，點一下就能查看。</p>
          <button type="button" id="show-past-codes" class="empty-action">查看過往服務<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></button>
        </div>

        <!-- Sections -->
        <div class="directory-sections">
          {sectionKeys.map((tag, index) => (
            <section class="tag-section" data-section={tag}>
              <header class="section-heading">
                <h2>{tag}</h2>
                <div class="section-actions">
                  <span><span data-section-count>{groupedCodes[tag].length}</span> 個服務</span>
                  <button type="button" class="section-expand" aria-expanded="false" aria-label={`展開「${tag}」的全部邀請碼`} title="展開全部" aria-controls={`invite-group-${index}`} hidden>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 8 5 5 5-5M7 14l5 5 5-5" /></svg>
                  </button>
                </div>
              </header>
              <div class="invite-grid" id={`invite-group-${index}`}>
                {groupedCodes[tag].map(code => (
                  <InviteCodeCard code={code} />
                ))}
              </div>
            </section>
          ))}
        </div>
      </>
    )}
  </article>

  <!-- ── Invite Code Detail Overlay ── -->
  <div id="ic-overlay" aria-hidden="true">
    <div id="ic-backdrop"></div>

    <!-- Desktop: Modal -->
    <div id="ic-modal" role="dialog" aria-modal="true" aria-label="邀請碼詳情" tabindex="-1">
      <button id="ic-close-modal" class="ic-close-btn" aria-label="關閉">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
      <div id="ic-detail-modal"></div>
    </div>

    <!-- Mobile: Bottom Sheet -->
    <div id="ic-sheet" role="dialog" aria-modal="true" aria-label="邀請碼詳情" tabindex="-1">
      <div id="ic-sheet-drag" aria-hidden="true">
        <div class="ic-handle-bar"></div>
      </div>
      <button id="ic-close-sheet" class="ic-close-btn" aria-label="關閉"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button>
      <div id="ic-sheet-scroll">
        <div id="ic-detail-sheet"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* overflow-x: hidden creates a scroll container that prevents the filter bar from sticking. */
  :global(body:has(.invite-directory)) { overflow-x: clip; }
  .invite-directory { max-width: 1080px; margin: auto; padding: 8rem 1.25rem 5rem; }
  .eyebrow { margin-bottom: 1.8rem; color: rgb(var(--color-primary)); font-family: 'JetBrains Mono', monospace; font-size: .75rem; letter-spacing: .14em; }
  h1 { font-size: clamp(2.2rem, 5.3vw, 4.1rem); font-weight: 700; line-height: 1.3; letter-spacing: -.035em; }
  h1 span { color: rgb(var(--color-primary)); }
  .hero-layout { display: grid; grid-template-columns: 1fr 340px; align-items: center; gap: 2rem; }
  .pocket-art { position: relative; height: 240px; isolation: isolate; }
  .pocket-ticket { position: absolute; top: 0; left: 0; width: 270px; height: 158px; padding: 1rem 1.2rem .75rem; border: 1px solid rgb(var(--ticket-color) / .35); border-radius: 14px; background: linear-gradient(120deg, rgb(var(--ticket-color) / .14), transparent), rgb(var(--color-bg-dark)); box-shadow: 0 12px 28px rgb(0 0 0 / .3); transform: translate(calc(var(--ticket-index) * 14px), calc(var(--ticket-index) * 40px)); text-align: left; cursor: grab; touch-action: pan-y; user-select: none; will-change: transform; }
  @media (hover: hover) and (pointer: fine) {
    .pocket-ticket:hover { box-shadow: 0 20px 40px rgb(0 0 0 / .4), 0 0 0 1px rgb(var(--ticket-color) / .55); }
  }
  .pocket-ticket img { pointer-events: none; }
  .is-dragging .pocket-ticket { cursor: grabbing; }
  .pocket-ticket:focus-visible { outline: 2px solid rgb(var(--ticket-color)); outline-offset: 4px; }
  .ticket-brand { display: flex; align-items: center; gap: .6rem; color: rgb(var(--ticket-color)); font-size: .85rem; font-weight: 600; }
  .ticket-brand img { width: 28px; height: 28px; object-fit: contain; border-radius: 5px; }
  .ticket-monogram { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid currentColor; border-radius: 5px; font-size: .65rem; }
  .ticket-arrow { margin-left: auto; }
  .ticket-benefit { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.8em; margin: .75rem 0; color: rgb(var(--color-text-primary)); font-size: .8rem; line-height: 1.4; }
  .ticket-stub { display: flex; justify-content: space-between; align-items: center; padding-top: .6rem; border-top: 1px dashed rgb(var(--ticket-color) / .3); color: rgb(var(--ticket-color)); font-family: 'JetBrains Mono', monospace; font-size: .6rem; }
  .ticket-barcode { width: 58px; height: 15px; opacity: .65; background: repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 3px, currentColor 3px 5px, transparent 5px 7px); }
  .intro-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-top: 2rem; }
  .intro-bottom p { margin: 0; color: rgb(var(--color-text-secondary)); line-height: 1.9; }
  .intro-bottom .updated-at { flex-shrink: 0; font-size: .75rem; text-align: right; }
  .updated-at time { font-family: 'JetBrains Mono', monospace; }
  .page-intro { margin-bottom: 2.5rem; }
  .tag-tabs-wrapper { position: sticky; top: 5rem; z-index: 41; display: flex; align-items: center; gap: .5rem; padding: .75rem 0; }
  :global(body:has(.invite-directory) .site-header)::before { transition: bottom .24s ease; }
  :global(body:has(.invite-directory) .site-header)::after {
    content: '';
    position: absolute;
    inset: 0 0 calc(-2rem - var(--header-shade-extension, 0px));
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(var(--color-bg-dark)) calc(100% - 3rem), rgb(var(--color-bg-dark) / 0));
    opacity: 0;
    transition: bottom .24s ease, opacity .24s ease;
  }
  :global(body:has(.invite-directory) .site-header.has-sticky-filter)::after { opacity: 1; }
  :global(body:has(.invite-directory) .site-header:has(#mobile-menu:not(.hidden), [data-nav-dropdown][open])) { z-index: 42; }
  @media (hover: hover) and (pointer: fine) {
    :global(body:has(.invite-directory) .site-header:has(.nav-dropdown:hover)) { z-index: 42; }
  }
  .tag-tabs-scroll { display: flex; flex: 1; min-width: 0; gap: .5rem; overflow-x: auto; scrollbar-width: none; }
  .tag-tabs-scroll::-webkit-scrollbar, .tag-section.is-collapsed .invite-grid::-webkit-scrollbar { display: none; }
  .subcategory-tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .subcategory-tab { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .5rem .75rem; border-radius: 6px; color: rgb(var(--color-text-secondary)); font-size: .8rem; cursor: pointer; transition: background .2s, color .2s; }
  .subcategory-tab span { font-family: 'JetBrains Mono', monospace; font-size: .75rem; }
  .subcategory-tab:hover, .subcategory-tab.active { background: rgb(var(--color-primary) / .08); color: rgb(var(--color-text-primary)); }
  .subcategory-tab.active { box-shadow: inset 0 -2px rgb(var(--color-primary) / .7); }
  .tag-tab, .filter-btn { min-height: 44px; flex-shrink: 0; padding: .5rem .875rem; border: 1px solid rgb(var(--color-text-primary) / .14); border-radius: 6px; color: rgb(var(--color-text-secondary)); font-size: .85rem; cursor: pointer; transition: border-color .2s, background .2s; white-space: nowrap; }
  .tag-tab span { margin-left: .4rem; font-family: 'JetBrains Mono', monospace; font-size: .7rem; }
  .tag-tab:hover, .filter-btn:hover { border-color: rgb(var(--color-primary) / .5); }
  .tag-tab.active, .filter-btn[data-active="true"] { color: rgb(var(--color-primary)); border-color: rgb(var(--color-primary) / .45); background: rgb(var(--color-primary) / .1); }
  .filter-btn { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; }
  .filter-btn[data-active="false"] .filter-check { visibility: hidden; }
  .directory-sections { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3.5rem; margin-top: 1.5rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
  .section-heading h2 { font-size: 1.15rem; font-weight: 600; }
  .section-actions { display: flex; align-items: center; gap: 1rem; }
  .section-expand { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: transparent; color: rgb(var(--color-primary)); cursor: pointer; transition: opacity .2s; }
  .section-expand:hover { opacity: .7; }
  .section-expand[aria-expanded="true"] svg { transform: rotate(180deg); }
  .section-actions > span { color: rgb(var(--color-text-secondary)); font-size: .75rem; }
  .invite-grid { display: grid; align-items: stretch; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .tag-section.is-collapsed .invite-grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 2rem) / 3.15); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: .75rem; }
  .tag-section.is-collapsed .invite-grid { mask-image: linear-gradient(to right, transparent, #000 var(--fade-left, 0px), #000 calc(100% - var(--fade-right, 0px)), transparent); }
  .tag-section.is-collapsed .invite-grid > :global(.ic-card) { scroll-snap-align: start; }
  .filter-empty { display: grid; justify-items: center; gap: .875rem; padding: 3rem 1rem; text-align: center; }
  .empty-art { display: grid; place-items: center; width: 80px; height: 80px; margin-bottom: .5rem; border-radius: 24px; background: radial-gradient(circle at 30% 20%, rgb(var(--color-primary) / .12), rgb(var(--color-primary) / .025)); color: rgb(var(--color-primary)); }
  .empty-art svg { transform: rotate(-8deg); }
  .filter-empty h2 { margin: 0; font-size: 1.1rem; font-weight: 600; line-height: 1.6; }
  .filter-empty p { margin: 0; color: rgb(var(--color-text-secondary)); font-size: .875rem; line-height: 1.8; }
  .empty-action { display: inline-flex; align-items: center; gap: .75rem; min-height: 44px; margin-top: .5rem; padding: .625rem 1rem; border: 1px solid rgb(var(--color-primary) / .3); border-radius: 99px; background: rgb(var(--color-primary) / .06); color: rgb(var(--color-text-primary)); font-size: .875rem; cursor: pointer; transition: background .2s; }
  .empty-action svg { color: rgb(var(--color-primary)); }
  .empty-action:hover { background: rgb(var(--color-primary) / .12); }
  [hidden] { display: none !important; }
  button:focus-visible { outline: 2px solid rgb(var(--color-primary)); outline-offset: 4px; }
  @media (max-width: 850px) { .invite-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tag-section.is-collapsed .invite-grid { grid-auto-columns: calc((100% - 1rem) / 2.15); } }
  @media (max-width: 700px) {
    .invite-directory { padding-top: 6rem; }
    .hero-layout { grid-template-columns: 1fr; gap: 2rem; }
    .pocket-art { width: 300px; max-width: 100%; height: 240px; margin: 0 auto; }
    .pocket-ticket { width: calc(100% - 30px); }
    .intro-bottom { display: block; }
    .intro-bottom .updated-at { margin-top: 1.25rem; text-align: left; }
    .invite-grid { grid-template-columns: 1fr; }
    .directory-sections { gap: 2.5rem; }
    .tag-section.is-collapsed .invite-grid { grid-auto-columns: 86%; }
  }
  @media (prefers-reduced-motion: reduce) { .tag-tab, .subcategory-tab, .filter-btn, .section-expand, .empty-action { transition: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(body:has(.invite-directory) .site-header)::before,
    :global(body:has(.invite-directory) .site-header)::after { transition: none; }
  }

  /* ── Overlay ── */
  #ic-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
  }
  #ic-overlay.ic-open { display: block; }

  #ic-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    cursor: pointer;
  }

  /* Modal */
  #ic-modal {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(600px, calc(100vw - 2rem));
    max-height: 90dvh;
    overflow: hidden;
    background: rgb(var(--color-bg-dark));
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 1.5rem;
    padding: 0;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5);
    scrollbar-width: none;
  }
  #ic-detail-modal { max-height: 90dvh; overflow-y: auto; scrollbar-width: none; }
  #ic-detail-modal::-webkit-scrollbar { display: none; }
  #ic-modal:focus, #ic-sheet:focus { outline: none; }

  /* Bottom Sheet */
  #ic-sheet {
    display: none;
    position: absolute;
    left: 0; right: 0; bottom: 0;
    max-height: 92dvh;
    isolation: isolate;
    background: radial-gradient(ellipse 560px 320px at 0 0, rgb(var(--brand-color) / .2), transparent 75%), rgb(var(--color-bg-dark));
    border-top: 1px solid rgba(255,255,255,0.1);
    border-radius: 1.5rem 1.5rem 0 0;
    flex-direction: column;
    overflow: hidden;
    will-change: transform;
  }
  #ic-sheet-drag {
    flex-shrink: 0;
    padding: 0.75rem 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    touch-action: none;
  }
  #ic-sheet-drag:active { cursor: grabbing; }
  .ic-handle-bar {
    width: 2.5rem; height: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,0.2);
  }
  #ic-sheet-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 0;
    min-height: 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #ic-sheet-scroll::-webkit-scrollbar { display: none; }

  /* Close button */
  .ic-close-btn {
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: rgb(var(--color-text-secondary));
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    z-index: 1;
  }
  .ic-close-btn:hover {
    background: rgba(255,255,255,0.12);
    color: rgb(var(--color-text-primary));
  }

  @media (prefers-reduced-motion: reduce) {
    #ic-overlay, #ic-overlay * { transition: none !important; }
  }
</style>

<style is:global>
  /* Detail markup is rendered in both the modal and the mobile sheet. */
  .ic-detail { position: relative; isolation: isolate; overflow: hidden; --brand-color: var(--color-primary); color: rgb(var(--color-text-primary)); background: radial-gradient(ellipse 560px 320px at 0 0, rgb(var(--brand-color) / .2), transparent 75%); }
  .ic-detail-hero { padding: 2rem 2rem 1.5rem; }
  .ic-detail::before, #ic-sheet::before { position: absolute; z-index: -1; top: -100px; right: -70px; width: 260px; height: 260px; border: 1px solid rgb(var(--brand-color) / .18); border-radius: 50%; box-shadow: 0 0 0 30px rgb(var(--brand-color) / .035), 0 0 0 60px rgb(var(--brand-color) / .025); pointer-events: none; content: ''; }
  #ic-detail-sheet .ic-detail { background: transparent; }
  #ic-detail-sheet .ic-detail::before { content: none; }
  .ic-detail-brand { display: flex; align-items: center; gap: .875rem; padding-right: 3rem; margin-bottom: 1.25rem; }
  .ic-detail-logo { display: grid; place-items: center; flex-shrink: 0; width: 60px; height: 60px; border: 1px solid rgb(var(--brand-color) / .3); border-radius: 16px; background: rgb(var(--color-bg-dark) / .8); box-shadow: 0 8px 24px rgb(0 0 0 / .18); color: rgb(var(--brand-color)); font-size: 1.25rem; font-weight: 700; }
  .ic-detail-logo img { width: 40px; height: 40px; border-radius: 9px; object-fit: contain; }
  .ic-detail-category { margin: 0 0 .35rem; color: rgb(var(--brand-color)); font-size: .75rem; letter-spacing: .06em; }
  .ic-detail-title { margin: 0; font-size: clamp(1.4rem, 4vw, 1.85rem); font-weight: 700; line-height: 1.4; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .ic-detail-status { display: inline-flex; align-items: center; gap: .4rem; color: rgb(var(--color-text-secondary)); font-size: .75rem; }
  .ic-detail-status::before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: ''; }
  .ic-detail-status[data-status="active"] { color: rgb(var(--brand-color)); }
  .ic-detail-status[data-status="expired"] { color: #f87171; }
  .ic-detail-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .ic-share-btn { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: 0 .75rem; border-radius: 8px; color: rgb(var(--color-text-secondary)); cursor: pointer; transition: background .2s, color .2s; font-size: .8rem; }
  .ic-share-btn:hover { background: rgb(var(--brand-color) / .08); color: rgb(var(--color-text-primary)); }
  .ic-share-btn:focus-visible { outline: 2px solid rgb(var(--brand-color)); outline-offset: 2px; }
  .ic-share-feedback { margin: .5rem 0 0; color: rgb(var(--color-text-secondary)); font-size: .8rem; overflow-wrap: anywhere; }
  .ic-detail-body { display: grid; gap: 1.5rem; padding: 0 2rem 2rem; }
  .ic-section-label { display: block; margin-bottom: .625rem; color: rgb(var(--color-text-secondary)); font-size: .75rem; font-weight: 500; }
  .ic-rewards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .ic-rewards:has(> :only-child) { grid-template-columns: 1fr; }
  .ic-benefit { min-width: 0; }
  .ic-benefit + .ic-benefit { padding-left: 1.5rem; border-left: 1px solid rgb(var(--color-text-primary) / .1); }
  .ic-benefit .ic-section-label { display: flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
  .ic-section-label svg { width: 20px; height: 20px; flex-shrink: 0; color: rgb(var(--brand-color)); }
  .ic-benefit p { margin: 0; color: rgb(var(--color-text-primary)); font-size: 1rem; line-height: 1.7; overflow-wrap: anywhere; }
  .ic-benefit--user p { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; }
  .ic-benefit--owner p { color: rgb(var(--color-text-secondary)); }
  .ic-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; padding: 1rem 0; border-block: 1px solid rgb(var(--color-text-primary) / .1); }
  .ic-code-row { display: grid; flex: 1; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: .75rem; min-width: 160px; }
  .ic-code-caption { display: block; margin-bottom: .35rem; color: rgb(var(--color-text-secondary)); font-size: .75rem; }
  .ic-code-caption:has(svg) { display: flex; align-items: center; gap: .5rem; }
  .ic-code-caption svg { width: 20px; height: 20px; flex-shrink: 0; color: rgb(var(--brand-color)); }
  .ic-code-text { flex: 1; min-width: 0; }
  .ic-code-value { display: flex; align-items: center; min-height: 44px; overflow-x: auto; scrollbar-width: none; white-space: nowrap; font-family: 'JetBrains Mono', monospace; font-size: 1.25rem; font-weight: 500; letter-spacing: .06em; }
  .ic-code-value::-webkit-scrollbar { display: none; }
  .ic-copy-btn { flex-shrink: 0; min-width: 44px; min-height: 44px; padding: .5rem; border: 0; background: transparent; color: rgb(var(--color-text-primary)); font-size: .8rem; cursor: pointer; transition: opacity .2s; }
  .ic-copy-btn:hover { opacity: .7; }
  .ic-copy-btn.copied { color: #4ade80; }
  .ic-link-btn { display: flex; align-items: center; gap: .625rem; min-height: 44px; padding: .625rem .875rem; margin-left: auto; border: 1px solid rgb(var(--brand-color) / .35); border-radius: 99px; color: rgb(var(--color-text-primary)); font-size: .8rem; font-weight: 500; text-decoration: none; transition: background .2s, border-color .2s; }
  .ic-link-btn svg { width: 20px; height: 20px; flex-shrink: 0; color: rgb(var(--brand-color)); }
  .ic-link-symbol { display: grid; place-items: center; flex-shrink: 0; }
  .ic-link-btn:hover { background: rgb(var(--brand-color) / .08); border-color: rgb(var(--brand-color) / .6); }
  .ic-link-btn > svg { transition: transform .2s; }
  .ic-link-btn:hover > svg { transform: translate(2px, -2px); }
  .ic-section-label:has(svg) { display: flex; align-items: center; gap: .5rem; }
  .ic-desc { color: rgb(var(--color-text-secondary)); font-size: .875rem; line-height: 1.9; overflow-wrap: anywhere; }
  .ic-desc ul, .ic-desc ol { padding-left: 1.25rem; margin: .35rem 0; }
  .ic-desc ul { list-style-type: disc; }
  .ic-desc ol { list-style-type: decimal; }
  .ic-desc li { margin-bottom: .3rem; }
  .ic-badge-row { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .875rem; }
  .ic-tag { padding: .2rem .5rem; border-radius: 4px; background: rgb(var(--brand-color) / .08); color: rgb(var(--color-text-secondary)); font-size: .75rem; }
  .ic-detail-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; padding-top: .75rem; border-top: 1px solid rgb(var(--color-text-primary) / .08); }
  .ic-date-row { display: flex; align-items: center; gap: .5rem; color: rgb(var(--color-text-secondary)); font-size: .75rem; }
  .ic-event-link { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; color: rgb(var(--color-text-secondary)); font-size: .75rem; text-decoration: none; }
  .ic-event-link:hover { color: rgb(var(--color-text-primary)); }
  .ic-detail button:focus-visible, .ic-detail a:focus-visible { outline: 2px solid rgb(var(--color-primary)); outline-offset: 4px; }
  @media (max-width: 767px) {
    .ic-detail-hero { padding: 1.25rem 1.25rem 1.5rem; }
    .ic-detail-body { padding: 0 1.25rem calc(1.5rem + env(safe-area-inset-bottom)); }
    .ic-detail-brand { gap: .75rem; }
    .ic-detail-logo { width: 52px; height: 52px; border-radius: 14px; }
    .ic-detail-logo img { width: 34px; height: 34px; }
    .ic-rewards { gap: 1rem; }
    .ic-benefit + .ic-benefit { padding-left: 1rem; }
    .ic-benefit--user p { font-size: 1.05rem; }
    .ic-desc { font-size: 1rem; line-height: 1.75; }
  }
  @media (max-width: 479px) {
    .ic-rewards { grid-template-columns: minmax(0, 1fr); }
    .ic-benefit { display: grid; grid-template-columns: min(6rem, 40%) minmax(0, 1fr); align-items: start; gap: .75rem; }
    .ic-benefit .ic-section-label { min-height: 1.7rem; margin: 0; line-height: 1.7; }
    .ic-benefit p { font-size: 1rem; }
    .ic-benefit + .ic-benefit { padding-left: 0; border-left: 0; }
    .ic-actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: .75rem; }
    .ic-code-row { min-width: 0; }
    .ic-actions .ic-link-btn { width: 100%; margin: 0; padding: .75rem .875rem; border: 0; border-radius: 10px; background: linear-gradient(100deg, rgb(var(--brand-color) / .08), rgb(var(--brand-color) / .025)); }
    .ic-actions .ic-link-content { flex: 1; }
    .ic-actions .ic-link-btn:hover { background: rgb(var(--brand-color) / .12); }
  }
  @media (prefers-reduced-motion: reduce) { .ic-copy-btn, .ic-link-btn, .ic-link-btn > svg { transition: none; } }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tag-tab');
  const subcategoryPanels = document.querySelectorAll<HTMLElement>('.subcategory-tabs');
  const subcategoryTabs = document.querySelectorAll<HTMLButtonElement>('.subcategory-tab');
  const sections = document.querySelectorAll<HTMLElement>('.tag-section');
  const filterBtn = document.getElementById('hide-expired-toggle') as HTMLButtonElement;

  let activeTag = '__all__';
  let activeSubcategory = '__all__';
  let hideInactive = true;

  const filterStatus = document.getElementById('filter-status');
  const filterEmpty = document.getElementById('filter-empty');
  document.querySelector<HTMLElement>('.tag-tabs-wrapper')?.removeAttribute('hidden');
  filterStatus?.removeAttribute('hidden');

  function updateScrollEdges(grid: HTMLElement) {
    const left = Math.max(0, Math.min(40, grid.scrollLeft));
    const right = Math.max(0, Math.min(40, grid.scrollWidth - grid.clientWidth - grid.scrollLeft));
    grid.style.setProperty('--fade-left', `${left}px`);
    grid.style.setProperty('--fade-right', `${right}px`);
  }

  function applyFilter() {
    let total = 0;
    sections.forEach(section => {
      const sectionTag = section.dataset.section;
      const tagMatch = activeTag === '__all__' || sectionTag === activeTag;

      const cards = section.querySelectorAll<HTMLElement>('[data-status]');
      let visibleCount = 0;
      let categoryCount = 0;
      const subcategoryCounts: Record<string, number> = {};
      cards.forEach(card => {
        const status = card.dataset.status;
        const inactive = hideInactive && (status === 'expired' || status === 'disabled');
        const subcategory = card.dataset.subcategory ?? '其他';
        if (!inactive) {
          categoryCount++;
          subcategoryCounts[subcategory] = (subcategoryCounts[subcategory] ?? 0) + 1;
        }
        const shouldHide = inactive || (activeSubcategory !== '__all__' && subcategory !== activeSubcategory);
        card.style.display = shouldHide ? 'none' : '';
        if (!shouldHide) visibleCount++;
      });

      section.classList.toggle('hidden', !tagMatch || visibleCount === 0);
      if (tagMatch) total += visibleCount;
      const expanded = section.dataset.expanded === 'true';
      section.classList.toggle('is-collapsed', !expanded);
      const expandButton = section.querySelector<HTMLButtonElement>('.section-expand');
      const columns = matchMedia('(max-width: 700px)').matches ? 1 : matchMedia('(max-width: 850px)').matches ? 2 : 3;
      if (expandButton) {
        expandButton.hidden = visibleCount <= columns;
        expandButton.setAttribute('title', expanded ? '收合' : '展開全部');
        expandButton.setAttribute('aria-expanded', String(expanded));
        expandButton.setAttribute('aria-label', `${expanded ? '收合' : '展開'}「${sectionTag}」的全部邀請碼`);
      }
      const grid = section.querySelector<HTMLElement>('.invite-grid');
      if (grid) updateScrollEdges(grid);
      const count = section.querySelector('[data-section-count]');
      if (count) count.textContent = String(visibleCount);
      const tab = Array.from(tabs).find(tab => tab.dataset.tag === sectionTag);
      const tabCount = tab?.querySelector('[data-count]');
      if (tabCount) tabCount.textContent = String(categoryCount);
      const panel = Array.from(subcategoryPanels).find(panel => panel.dataset.parentCategory === sectionTag);
      if (panel) {
        panel.hidden = activeTag !== sectionTag;
        panel.querySelectorAll<HTMLButtonElement>('.subcategory-tab').forEach(button => {
          const selected = button.dataset.subcategory === activeSubcategory;
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
          const count = button.querySelector('[data-count]');
          if (count) count.textContent = String(subcategoryCounts[button.dataset.subcategory ?? ''] ?? 0);
        });
      }
    });
    const allCount = tabs[0]?.querySelector('[data-count]');
    if (allCount) allCount.textContent = String(Array.from(document.querySelectorAll<HTMLElement>('.ic-card')).filter(card => !hideInactive || card.dataset.status === 'active').length);
    if (filterStatus) filterStatus.textContent = `顯示 ${total} 個${hideInactive ? '有效' : ''}服務`;
    if (filterEmpty) filterEmpty.hidden = total > 0;
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      activeTag = tab.dataset.tag ?? '__all__';
      activeSubcategory = '__all__';
      sections.forEach(section => { section.dataset.expanded = String(!matchMedia('(max-width: 700px)').matches && section.dataset.section === activeTag); });
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-pressed', String(t === tab));
      });
      tab.classList.add('active');
      applyFilter();
    });
  });

  subcategoryTabs.forEach(button => {
    button.addEventListener('click', () => {
      activeSubcategory = button.dataset.subcategory ?? '__all__';
      applyFilter();
      const section = Array.from(sections).find(section => section.dataset.section === activeTag);
      const grid = section?.querySelector<HTMLElement>('.invite-grid');
      if (grid) {
        grid.scrollLeft = 0;
        updateScrollEdges(grid);
      }
    });
  });

  filterBtn?.addEventListener('click', () => {
    hideInactive = !hideInactive;
    filterBtn.dataset.active = String(hideInactive);
    filterBtn.setAttribute('aria-pressed', String(hideInactive));
    applyFilter();
  });
  document.getElementById('show-past-codes')?.addEventListener('click', () => filterBtn?.click());

  sections.forEach(section => {
    const grid = section.querySelector<HTMLElement>('.invite-grid');
    grid?.addEventListener('scroll', () => updateScrollEdges(grid), { passive: true });
    section.querySelector('.section-expand')?.addEventListener('click', () => {
      const grid = section.querySelector<HTMLElement>('.invite-grid');
      const expanded = section.dataset.expanded !== 'true';
      if (expanded && grid) section.dataset.scrollLeft = String(grid.scrollLeft);
      section.dataset.expanded = String(expanded);
      applyFilter();
      if (!expanded && grid) {
        grid.scrollLeft = Number(section.dataset.scrollLeft ?? 0);
        updateScrollEdges(grid);
      }
    });
  });
  window.addEventListener('resize', applyFilter);
  applyFilter();

  // Extend the header shade only while the filter bar is stuck.
  const filterBar = document.querySelector<HTMLElement>('.tag-tabs-wrapper');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (filterBar && siteHeader) {
    let pending = false;
    let previousExtension = '';
    const updateHeaderShade = () => {
      pending = false;
      const rect = filterBar.getBoundingClientRect();
      const stickyTop = parseFloat(getComputedStyle(filterBar).top);
      const fadeLength = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const extension = Math.abs(rect.top - stickyTop) <= 1 && rect.height > 0
        ? `${Math.max(0, rect.bottom - siteHeader.getBoundingClientRect().bottom + fadeLength)}px`
        : '0px';
      if (extension !== previousExtension) {
        siteHeader.style.setProperty('--header-shade-extension', extension);
        siteHeader.classList.toggle('has-sticky-filter', extension !== '0px');
        previousExtension = extension;
      }
    };
    const scheduleHeaderShade = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(updateHeaderShade);
    };
    window.addEventListener('scroll', scheduleHeaderShade, { passive: true });
    window.addEventListener('resize', scheduleHeaderShade);
    updateHeaderShade();
  }

  // ── Invite Code Overlay ────────────────────────────────────────────────────
  import { getInviteBrand, selectHeroCodes } from '../../data/invite-brands';
  import type { InviteCode } from '../../types/invite';
  import { initHeroWallet } from '../invite-codes/heroWallet';
  import { getInviteSlug } from '../../data/invite-share';
  import { observeInviteImpressions, trackInviteEvent, type InviteEntryPoint } from '../invite-codes/analytics';

  const heroTickets = document.querySelectorAll<HTMLElement>('.pocket-ticket');
  if (heroTickets.length) {
    const codes: InviteCode[] = Array.from(document.querySelectorAll<HTMLElement>('.ic-card'))
      .map(card => JSON.parse(card.dataset.invite!));
    let previousTitles: string[] = [];
    try {
      const saved = JSON.parse(sessionStorage.getItem('invite-hero') ?? '[]');
      if (Array.isArray(saved)) previousTitles = saved.filter(title => typeof title === 'string');
    } catch { /* Storage may be unavailable; still show a random selection. */ }
    const chosen = selectHeroCodes(codes, Math.random, previousTitles);
    try {
      sessionStorage.setItem('invite-hero', JSON.stringify(chosen.map(code => code.title)));
    } catch { /* Hero works without storage, but may repeat on reload. */ }

    heroTickets.forEach((ticket, index) => {
      const code = chosen[index];
      ticket.hidden = !code;
      if (!code) return;
      const brand = getInviteBrand(code.title);
      ticket.style.setProperty('--ticket-color', brand.color);
      ticket.querySelector('.ticket-title')!.textContent = code.title;
      ticket.setAttribute('aria-label', `將 ${code.title} 卡片帶到前面`);
      ticket.querySelector('.ticket-benefit')!.textContent = code.user_benefit || code.description;
      const mark = document.createElement(brand.icon ? 'img' : 'span');
      if (mark instanceof HTMLImageElement) {
        mark.src = `/images/invite-brands/${brand.icon}.png`;
        mark.alt = '';
        mark.width = mark.height = 32;
      } else {
        mark.className = 'ticket-monogram';
        mark.textContent = code.title.slice(0, 2);
      }
      ticket.querySelector('.ticket-brand')!.firstElementChild!.replaceWith(mark);
    });
    initHeroWallet(Array.from(heroTickets).filter(ticket => !ticket.hidden));
  }

  const overlay   = document.getElementById('ic-overlay')!;
  const backdrop  = document.getElementById('ic-backdrop')!;
  const modal     = document.getElementById('ic-modal')!;
  const sheet     = document.getElementById('ic-sheet')!;
  const detailM   = document.getElementById('ic-detail-modal')!;
  const detailS   = document.getElementById('ic-detail-sheet')!;
  const sheetScroll = document.getElementById('ic-sheet-scroll')!;
  const sheetDrag   = document.getElementById('ic-sheet-drag')!;

  const SPRING  = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
  const EASE_IO = 'cubic-bezier(0.32, 0.72, 0, 1)';
  const isMobile = () => window.innerWidth < 768;

  // ── Detail HTML renderer ──────────────────────────────────────────────────
  function esc(s: unknown) {
    return String(s ?? '')
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  type InviteData = Record<string, unknown>;

  function renderDetail(c: InviteData): string {
    const title = String(c.title ?? '');
    const brand = getInviteBrand(title);
    const statusLabels: Record<string, string> = { active: '有效', expired: '已到期', disabled: '已停用' };
    const status = String(c.status ?? 'active');
    const tags = (Array.isArray(c.tags) ? c.tags : []).map((t: unknown) => `<span class="ic-tag">${esc(t)}</span>`).join('');
    const dateRange = c.start_date && c.end_date
      ? `${esc(c.start_date)} → ${esc(c.end_date)}`
      : c.end_date ? `至 ${esc(c.end_date)}` : '';
    const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>';

    const linkSymbol = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M15 7h2a5 5 0 0 1 0 10h-2M9 17H7A5 5 0 0 1 7 7h2M8 12h8" /></svg>';

    return `
      <div class="ic-detail" style="--brand-color: ${brand.color}">
        <header class="ic-detail-hero">
          <div class="ic-detail-brand">
            <span class="ic-detail-logo" aria-hidden="true">${brand.icon ? `<img src="/images/invite-brands/${brand.icon}.png" width="40" height="40" alt="" />` : esc(title.slice(0, 2))}</span>
            <div><p class="ic-detail-category">${esc(c.group ?? '其他')}</p><h2 class="ic-detail-title">${esc(title)}</h2></div>
          </div>
          <div class="ic-detail-meta"><span class="ic-detail-status" data-status="${esc(status)}">${statusLabels[status] ?? statusLabels.active}</span>
            <button type="button" class="ic-share-btn" data-share="${esc(title)}" aria-label="分享 ${esc(title)}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8" /></svg>分享</button>
          </div><p class="ic-share-feedback" role="status" hidden></p>
        </header>
        <div class="ic-detail-body">
          ${c.user_benefit || c.my_benefit ? `<section class="ic-rewards" aria-label="邀請回饋">
            ${c.user_benefit ? `<div class="ic-benefit ic-benefit--user"><h3 class="ic-section-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M5 12v9h14v-9M12 8v13M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z" /></svg>你能獲得</h3><p>${esc(c.user_benefit)}</p></div>` : ''}
            ${c.my_benefit ? `<div class="ic-benefit ic-benefit--owner"><h3 class="ic-section-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10V3l5 4a12 12 0 0 1 6 0l5-4v7c1 2 1 5-1 7-3 4-11 4-14 0-2-2-2-5-1-7Z" /><path d="M8 12h.01M16 12h.01m-5 3 1 1 1-1M3 14H1m2 3-2 1m20-4h2m-2 3 2 1" /></svg>貓貓獲得</h3><p>${esc(c.my_benefit)}</p></div>` : ''}
          </section>` : ''}
          ${c.invite_code || c.invite_link ? `<div class="ic-actions">
            <div class="ic-code-row"><div class="ic-code-text">
              <span class="ic-code-caption">${c.invite_code ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5ZM9 5v14" /></svg>邀請碼' : `${linkSymbol}邀請連結`}</span>
              ${c.invite_code ? `<span class="ic-code-value">${esc(c.invite_code)}</span>` : ''}
            </div>${c.invite_code ? `<button type="button" class="ic-copy-btn" data-copy="${esc(c.invite_code)}" aria-live="polite">複製</button>` : ''}</div>
            ${c.invite_link ? `<a href="${esc(c.invite_link)}" target="_blank" rel="noopener noreferrer" class="ic-link-btn" aria-label="透過邀請連結領取回饋（開新分頁）"><span class="ic-link-symbol" aria-hidden="true">${linkSymbol}</span><span class="ic-link-content">領取回饋</span>${arrow}</a>` : ''}
          </div>` : ''}
          ${c.description || tags ? `<section><h3 class="ic-section-label"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H5v18h14V8zM14 3v5h5M8 12h8M8 16h5" /></svg>服務說明</h3><div class="ic-desc">${formatDesc(String(c.description ?? ''))}</div>${tags ? `<div class="ic-badge-row">${tags}</div>` : ''}</section>` : ''}
          ${dateRange || c.official_link ? `<footer class="ic-detail-footer">
            ${dateRange ? `<span class="ic-date-row"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18" /></svg>${dateRange}</span>` : ''}
            ${c.official_link ? `<a href="${esc(c.official_link)}" target="_blank" rel="noopener noreferrer" class="ic-event-link" aria-label="活動頁面（開新分頁）">活動頁面${arrow}</a>` : ''}
          </footer>` : ''}
        </div>
      </div>
    `;
  }

  // ── Description formatter: supports \n, - lists, 1. lists ──────────────
  function formatDesc(raw: string): string {
    const lines = esc(raw).split(/\r?\n/);
    let html = '';
    let inUl = false;
    let inOl = false;

    const closeList = () => {
      if (inUl) { html += '</ul>'; inUl = false; }
      if (inOl) { html += '</ol>'; inOl = false; }
    };

    for (const line of lines) {
      const ul = line.match(/^[-*]\s+(.+)/);
      const ol = line.match(/^\d+\.\s+(.+)/);

      if (ul) {
        if (inOl) { html += '</ol>'; inOl = false; }
        if (!inUl) { html += '<ul>'; inUl = true; }
        html += `<li>${ul[1]}</li>`;
      } else if (ol) {
        if (inUl) { html += '</ul>'; inUl = false; }
        if (!inOl) { html += '<ol>'; inOl = true; }
        html += `<li>${ol[1]}</li>`;
      } else {
        closeList();
        html += line.trim() === '' ? '<br>' : line + '<br>';
      }
    }
    closeList();
    return html.replace(/<br>$/, '');
  }
  function bindCopyBtns(root: HTMLElement, data: InviteData, entryPoint: InviteEntryPoint) {
    root.querySelectorAll<HTMLButtonElement>('.ic-copy-btn').forEach(btn => {
      btn.addEventListener('click', async e => {
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        } catch {
          btn.textContent = '複製失敗，請手動複製';
          return;
        }
        trackInviteEvent('invite_copy', analyticsService(data), entryPoint);
        btn.textContent = '✓ 已複製';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = '複製'; btn.classList.remove('copied'); }, 1800);
      });
    });
  }

  // ── Open / Close ──────────────────────────────────────────────────────────
  function getShareUrl(title: string): string {
    return new URL(`/invite-codes/${getInviteSlug(title)}/`, window.location.href).href;
  }

  async function shareService(title: string, feedback: HTMLElement, data: InviteData, entryPoint: InviteEntryPoint) {
    const url = getShareUrl(title);
    feedback.hidden = true;
    if (navigator.share) {
      try {
        await navigator.share({ title: `${title} 邀請碼與回饋`, url });
        trackInviteEvent('invite_share', analyticsService(data), entryPoint, 'native');
        return;
      } catch (error) {
        if (error instanceof Error && error.name === 'AbortError') return;
      }
    }
    try {
      await navigator.clipboard.writeText(url);
      trackInviteEvent('invite_share', analyticsService(data), entryPoint, 'copy_link');
      feedback.textContent = '分享連結已複製';
    } catch {
      feedback.textContent = `請複製分享連結：${url}`;
    }
    feedback.hidden = false;
  }

  function bindShareBtn(root: HTMLElement, data: InviteData, entryPoint: InviteEntryPoint) {
    const button = root.querySelector<HTMLButtonElement>('.ic-share-btn');
    const feedback = root.querySelector<HTMLElement>('.ic-share-feedback');
    button?.addEventListener('click', () => {
      if (feedback) void shareService(button.dataset.share ?? '', feedback, data, entryPoint);
    });
  }

  function clearSharedService() {
    const url = new URL(window.location.href);
    if (!url.searchParams.has('service') && url.pathname === '/invite-codes/') return;
    url.searchParams.delete('service');
    url.pathname = '/invite-codes/';
    window.history.replaceState(window.history.state, '', url);
  }

  let returnFocus: HTMLElement | null = null;
  let activeDialog: HTMLElement = modal;

  function analyticsService(data: InviteData) {
    return { title: String(data.title ?? ''), group: String(data.group ?? '') };
  }

  function bindDetailLinks(root: HTMLElement, data: InviteData, entryPoint: InviteEntryPoint) {
    root.querySelector('.ic-link-btn')?.addEventListener('click', () => {
      trackInviteEvent('invite_click', analyticsService(data), entryPoint);
    });
    root.querySelector('.ic-event-link')?.addEventListener('click', () => {
      trackInviteEvent('invite_official_click', analyticsService(data), entryPoint);
    });
  }

  observeInviteImpressions(document.querySelectorAll<HTMLElement>('.ic-card'), overlay);

  function openOverlay(data: InviteData, entryPoint: InviteEntryPoint = 'directory') {
    returnFocus = document.activeElement as HTMLElement;
    activeDialog = isMobile() ? sheet : modal;
    overlay.classList.add('ic-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    requestAnimationFrame(() => {
      backdrop.style.transition = 'background 0.3s, backdrop-filter 0.3s';
      backdrop.style.background = 'rgba(0,0,0,0.65)';
      (backdrop.style as CSSStyleDeclaration & { webkitBackdropFilter: string }).webkitBackdropFilter = 'blur(8px)';
      backdrop.style.backdropFilter = 'blur(8px)';
    });

    if (!isMobile()) {
      modal.setAttribute('aria-label', `${String(data.title ?? '')} 邀請碼詳情`);
      detailM.innerHTML = renderDetail(data);
      detailM.scrollTop = 0;
      bindCopyBtns(detailM, data, entryPoint);
      bindShareBtn(detailM, data, entryPoint);
      bindDetailLinks(detailM, data, entryPoint);
      modal.style.display = 'block';
      modal.style.opacity = '0';
      modal.style.transform = 'translate(-50%, -50%) scale(0.94) translateY(10px)';
      requestAnimationFrame(() => requestAnimationFrame(() => {
        modal.style.transition = `opacity 0.3s ${SPRING}, transform 0.3s ${SPRING}`;
        modal.style.opacity = '1';
        modal.style.transform = 'translate(-50%, -50%) scale(1) translateY(0)';
      }));
    } else {
      sheet.setAttribute('aria-label', `${String(data.title ?? '')} 邀請碼詳情`);
      sheet.style.setProperty('--brand-color', getInviteBrand(String(data.title ?? '')).color);
      detailS.innerHTML = renderDetail(data);
      bindCopyBtns(detailS, data, entryPoint);
      bindShareBtn(detailS, data, entryPoint);
      bindDetailLinks(detailS, data, entryPoint);
      sheetScroll.scrollTop = 0;
      sheet.style.display = 'flex';
      sheet.style.transform = 'translateY(100%)';
      requestAnimationFrame(() => requestAnimationFrame(() => {
        sheet.style.transition = `transform 0.38s ${EASE_IO}`;
        sheet.style.transform = 'translateY(0)';
      }));
    }
    activeDialog.focus();
    trackInviteEvent('invite_view', analyticsService(data), entryPoint);
  }

  function closeOverlay() {
    clearSharedService();
    backdrop.style.transition = 'background 0.25s ease-in, backdrop-filter 0.25s ease-in';
    backdrop.style.background = 'rgba(0,0,0,0)';
    backdrop.style.backdropFilter = 'blur(0px)';

    if (activeDialog === modal) {
      modal.style.transition = 'opacity 0.2s ease-in, transform 0.2s ease-in';
      modal.style.opacity = '0';
      modal.style.transform = 'translate(-50%, -50%) scale(0.94) translateY(10px)';
    } else {
      sheet.style.transition = 'transform 0.3s ease-in';
      sheet.style.transform = 'translateY(100%)';
    }

    setTimeout(() => {
      overlay.classList.remove('ic-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      modal.style.cssText = '';
      sheet.style.cssText = '';
      backdrop.style.cssText = '';
      returnFocus?.focus();
    }, 320);
  }

  document.querySelectorAll<HTMLButtonElement>('.card-detail').forEach(button => {
    button.addEventListener('click', () => {
      const card = button.closest<HTMLElement>('.ic-card');
      if (card?.dataset.invite) openOverlay(JSON.parse(card.dataset.invite));
    });
  });

  function openSharedService() {
    const title = document.querySelector<HTMLElement>('.invite-directory')?.dataset.sharedService || new URL(window.location.href).searchParams.get('service');
    if (!title) return;
    for (const card of document.querySelectorAll<HTMLElement>('.ic-card')) {
      if (!card.dataset.invite) continue;
      const data: InviteData = JSON.parse(card.dataset.invite);
      if (String(data.title ?? '').trim() === title.trim()) {
        const sharedPage = document.querySelector<HTMLElement>('.invite-directory')?.dataset.sharedService;
        openOverlay(data, sharedPage ? 'shared_page' : 'shared_query');
        return;
      }
    }
    clearSharedService();
  }
  openSharedService();

  backdrop.addEventListener('click', closeOverlay);
  document.getElementById('ic-close-modal')?.addEventListener('click', closeOverlay);
  document.getElementById('ic-close-sheet')?.addEventListener('click', closeOverlay);
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!overlay.classList.contains('ic-open')) return;
    if (e.key === 'Tab') {
      const controls = Array.from(activeDialog.querySelectorAll<HTMLElement>('button, a[href]'));
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (e.shiftKey && (document.activeElement === first || document.activeElement === activeDialog)) {
        e.preventDefault(); last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first?.focus();
      }
    }
    if (e.key === 'Escape' && overlay.classList.contains('ic-open')) closeOverlay();
  });

  // ── Touch drag (Bottom Sheet handle) ─────────────────────────────────────
  let dragStartY = 0, dragCurrentY = 0, isDragging = false;
  let velY = 0, lastTY = 0, lastTT = 0;

  sheetDrag.addEventListener('touchstart', (e: TouchEvent) => {
    const t = e.touches[0];
    dragStartY = dragCurrentY = lastTY = t.clientY;
    lastTT = Date.now(); velY = 0; isDragging = true;
    sheet.style.transition = 'none';
  }, { passive: true });

  window.addEventListener('touchmove', (e: TouchEvent) => {
    if (!isDragging) return;
    const t = e.touches[0];
    dragCurrentY = t.clientY;
    const delta = dragCurrentY - dragStartY;
    const now = Date.now(); const dt = Math.max(now - lastTT, 1);
    velY = (t.clientY - lastTY) / dt;
    lastTY = t.clientY; lastTT = now;

    if (delta > 0) {
      e.preventDefault();
      sheet.style.transform = `translateY(${delta}px)`;
      const progress = Math.min(delta / (sheet.offsetHeight || 600), 1);
      backdrop.style.opacity = String(1 - progress * 0.8);
    }
  }, { passive: false });

  window.addEventListener('touchend', () => {
    if (!isDragging) return;
    isDragging = false;
    const delta = dragCurrentY - dragStartY;
    sheet.style.transition = `transform 0.35s ${EASE_IO}`;
    backdrop.style.transition = 'opacity 0.35s';
    if (delta > 0 && (velY > 0.5 || delta > (sheet.offsetHeight || 600) * 0.4)) {
      closeOverlay();
    } else {
      sheet.style.transform = 'translateY(0)';
      backdrop.style.opacity = '1';
    }
  }, { passive: true });
</script>
