---
import { siteConfig } from '../../config/site';

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
if (measurementId && !/^G-[A-Z0-9]+$/.test(measurementId)) {
  throw new Error('PUBLIC_GA_MEASUREMENT_ID must be a GA4 measurement ID (G-XXXXXXXXXX)');
}
const hostname = new URL(siteConfig.url).hostname;
---

{import.meta.env.PROD && measurementId && (
  <script is:inline define:vars={{ measurementId, hostname }}>
    if (location.hostname === hostname) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', measurementId);

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    }
  </script>
)}
