---
/**
 * Header Navigation Component
 * Following SOLID principles: Single Responsibility
 */
import { siteConfig } from '../../config/site';

export interface Props {
  currentPath?: string;
}

const { currentPath: path = '/' } = Astro.props;
const currentPath = path.endsWith('/') ? path : `${path}/`;
const navItems = siteConfig.nav;
---

<header class="site-header fixed top-0 left-0 right-0 z-40 border-b">
  <nav class="container mx-auto px-6 py-4">
    <div class="relative flex items-center justify-between">
      <!-- Logo -->
      <a
        href="/"
        aria-label="HEITANG，回到首頁"
        class="flex items-center gap-3 group"
      >
        <div class="w-9 h-9 flex items-center justify-center rounded-xl overflow-hidden transition-all
          group-hover:scale-110 group-hover:drop-shadow-[0_0_8px_rgba(255,140,97,0.6)]">
          <img src="/images/icon.png" alt="Logo" class="w-full h-full object-contain" />
        </div>
        <span class="site-brand heitang-brand-font text-[0.95rem] font-bold tracking-[0.16em] text-[rgb(var(--color-primary))] transition-colors group-hover:text-white">
          HEITANG
        </span>
      </a>

      <!-- Navigation Links -->
      <ul class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 md:flex">
        {navItems.map((item, index) => (
          'children' in item ? (
            <li class="nav-dropdown" data-nav-group>
              <details class="nav-dropdown-toggle" data-nav-dropdown>
                <summary
                  class:list={[
                    "nav-link nav-dropdown-summary group relative flex h-9 items-center gap-1 text-sm font-medium leading-none transition-all duration-200",
                    item.children.some(child => currentPath === child.href)
                      ? "nav-link--active text-white"
                      : "text-white/60 hover:text-white"
                  ]}
                  aria-controls={`desktop-nav-group-${index}`}
                >
                  {item.label}
                  <svg class="nav-dropdown-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                  </svg>
                  <span class:list={[
                    "absolute bottom-1.5 left-0 w-full h-px bg-[rgb(var(--color-primary))] transform transition-transform duration-300 origin-left",
                    item.children.some(child => currentPath === child.href)
                      ? "scale-x-100"
                      : "scale-x-0 group-hover:scale-x-100"
                  ]}></span>
                </summary>
              </details>

              <ul id={`desktop-nav-group-${index}`} class="nav-dropdown-menu" aria-label={`${item.label}選單`}>
                {item.children.map(child => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={currentPath === child.href ? 'page' : undefined}
                      class:list={[
                        'nav-dropdown-link',
                        currentPath === child.href ? 'nav-dropdown-link--active' : ''
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class:list={[
                  "nav-link group relative inline-flex h-9 items-center text-sm font-medium leading-none transition-all duration-200",
                  currentPath === item.href
                    ? "nav-link--active text-white"
                    : "text-white/60 hover:text-white"
                ]}
              >
                {item.label}
                <span class:list={[
                  "absolute bottom-1.5 left-0 w-full h-px bg-[rgb(var(--color-primary))] transform transition-transform duration-300 origin-left",
                  currentPath === item.href ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"
                ]}></span>
              </a>
            </li>
          )
        ))}
      </ul>

      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub（開新分頁）"
        class="header-github hidden h-9 w-9 items-center justify-center rounded-full transition-all duration-200 md:inline-flex"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Mobile Button -->
      <button
        id="mobile-menu-btn"
        class="flex h-11 w-11 items-center justify-center text-white md:hidden"
        aria-label="開啟選單"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pt-4 border-t border-white/10">
      <ul class="flex flex-col gap-1">
        {navItems.map((item, index) => (
          'children' in item ? (
            <li class="mobile-nav-dropdown" data-nav-group>
              <details class="mobile-nav-dropdown-toggle" data-nav-dropdown>
                <summary
                  class:list={[
                    'mobile-nav-dropdown-summary',
                    item.children.some(child => currentPath === child.href) ? 'text-white' : 'text-white/60'
                  ]}
                  aria-controls={`mobile-nav-group-${index}`}
                >
                  {item.label}
                  <svg class="nav-dropdown-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                  </svg>
                </summary>
              </details>

              <ul id={`mobile-nav-group-${index}`} class="mobile-nav-dropdown-menu">
                {item.children.map(child => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={currentPath === child.href ? 'page' : undefined}
                      class:list={[
                        'mobile-nav-dropdown-link',
                        currentPath === child.href ? 'text-white' : 'text-white/60'
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class:list={[
                  "flex min-h-11 items-center text-sm font-medium transition-colors",
                  currentPath === item.href
                    ? "text-white"
                    : "text-white/60 hover:text-white"
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-color: rgb(var(--color-primary) / 0.16);
    background: linear-gradient(
      180deg,
      rgb(var(--color-bg-dark) / 0.9),
      rgb(var(--color-bg-dark) / 0.68)
    );
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.16);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
  }

  .site-brand {
    text-shadow: 0 0 12px rgb(var(--color-primary) / 0.38);
  }

  .nav-link,
  .nav-dropdown-link,
  .mobile-nav-dropdown-summary,
  .mobile-nav-dropdown-link,
  #mobile-menu > ul > li > a {
    font-family: 'Genki Gothic TW Nav', 'Noto Sans TC', sans-serif;
    font-weight: 700;
    letter-spacing: 0.065em;
  }

  .header-github {
    color: rgb(var(--color-text-secondary));
  }

  .header-github svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .header-github:hover {
    color: white;
    filter: drop-shadow(0 0 8px rgb(var(--color-primary) / 0.55));
  }

  .header-github:focus-visible {
    outline: 2px solid rgb(var(--color-primary));
    outline-offset: 3px;
  }

  .nav-link:hover {
    text-shadow:
      0 0 8px rgba(var(--color-primary) / 0.9),
      0 0 20px rgba(var(--color-primary) / 0.5);
  }
  .nav-link--active {
    text-shadow:
      0 0 6px rgba(var(--color-primary) / 0.6),
      0 0 16px rgba(var(--color-primary) / 0.3);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-summary,
  .mobile-nav-dropdown-summary {
    cursor: pointer;
    list-style: none;
  }

  .nav-dropdown-summary::-webkit-details-marker,
  .mobile-nav-dropdown-summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown-chevron {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 180ms ease;
  }

  .nav-dropdown-toggle[open] .nav-dropdown-chevron,
  .mobile-nav-dropdown-toggle[open] .nav-dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    z-index: 1;
    top: calc(100% + 0.625rem);
    left: 50%;
    display: grid;
    width: 10.5rem;
    gap: 0.125rem;
    margin: 0;
    padding: 0.375rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.875rem;
    background: rgb(var(--color-bg-medium) / 0.92);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 16px 36px rgba(0, 0, 0, 0.42),
      0 3px 10px rgba(0, 0, 0, 0.24);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    transform: translate(-50%, -0.375rem);
    transform-origin: top center;
    transition: opacity 160ms ease, visibility 160ms ease, transform 160ms ease;
  }

  .nav-dropdown::after {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 10.5rem;
    height: 0.625rem;
    content: '';
    transform: translateX(-50%);
  }

  .nav-dropdown-toggle[open] + .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-dropdown:hover .nav-dropdown-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate(-50%, 0);
    }
  }

  .nav-dropdown-link,
  .mobile-nav-dropdown-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    border-radius: 0.5rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    transition: color 160ms ease, background 160ms ease;
  }

  .nav-dropdown-link {
    position: relative;
    padding: 0 0.625rem 0 0.75rem;
    border-left: 2px solid transparent;
  }

  .nav-dropdown-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.055);
  }

  .nav-dropdown-link--active {
    color: white;
    border-left-color: rgb(var(--color-primary) / 0.82);
    background: rgb(var(--color-primary) / 0.1);
  }

  .mobile-nav-dropdown-summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .mobile-nav-dropdown-menu {
    display: none;
    gap: 0.125rem;
    margin: 0;
    padding: 0 0 0.25rem 0.75rem;
  }

  .mobile-nav-dropdown-toggle[open] + .mobile-nav-dropdown-menu {
    display: grid;
  }

  .mobile-nav-dropdown-link {
    padding: 0 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown-menu,
    .nav-dropdown-chevron {
      transition: none;
    }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isOpen = !mobileMenu.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
  });

  const navDropdowns = document.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]');
  const closeNavDropdowns = (restoreFocus = false) => {
    navDropdowns.forEach(dropdown => {
      if (!dropdown.open) return;
      dropdown.open = false;
      if (restoreFocus) dropdown.querySelector('summary')?.focus();
    });
  };

  document.addEventListener('pointerdown', event => {
    if (event.target instanceof Element && !event.target.closest('[data-nav-group]')) {
      closeNavDropdowns();
    }
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeNavDropdowns(true);
  });
</script>
