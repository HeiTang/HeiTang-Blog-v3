---
import { getImage } from 'astro:assets';
import type { ProjectScreenshot } from '../../types/projects';
interface Props { screenshots: ProjectScreenshot[]; title: string; sizes?: string; }
const { screenshots, title, sizes = '(max-width: 1080px) calc(100vw - 40px), 1040px' } = Astro.props;
const images = await Promise.all(screenshots.map(async (shot) => {
  const asset = typeof shot === 'string' ? shot : shot.src;
  const caption = typeof shot === 'string' ? title : (shot.caption ?? title);
  if (typeof asset === 'string') return { src: asset, caption };
  const width = Math.min(1600, asset.width);
  const widths = [...[480, 850, 1200].filter(candidate => candidate < width), width];
  const image = await getImage({ src: asset, width, widths, format: 'webp', quality: 85 });
  return { src: image.src, srcset: image.srcSet.attribute, caption, width: image.attributes.width, height: image.attributes.height };
}));
---
<div class="gallery">
  {images.map((image, index) => <figure>
    <button class="gallery-open" type="button" aria-label={`放大：${image.caption}`} aria-haspopup="dialog">
      <img src={image.src} srcset={image.srcset} sizes={image.srcset ? sizes : undefined} width={image.width} height={image.height} alt={image.caption} loading="lazy" decoding="async" data-scroll-reveal />
      <span class="zoom-label" aria-hidden="true">放大 <svg class="zoom-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H3v6" /><path d="M15 3h6v6" /><path d="M21 15v6h-6" /><path d="M3 15v6h6" /></svg></span>
    </button>
    <figcaption><span aria-hidden="true">{String(index + 1).padStart(2, '0')} / </span>{image.caption}</figcaption>
  </figure>)}
</div>
{images.length > 0 && <dialog class="image-dialog" aria-label="專案圖片預覽">
  <button class="gallery-close" type="button" aria-label="關閉圖片預覽">關閉 ×</button>
  <figure><img alt="" decoding="async" /><figcaption></figcaption></figure>
</dialog>}
<style>
  .gallery { display: grid; gap: 2.5rem; }
  figure { margin: 0; min-width: 0; }
  .gallery-open { display: block; position: relative; width: 100%; border-radius: 12px; overflow: hidden; background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.12); cursor: zoom-in; }
  .gallery-open img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: .8rem; font-size: .85rem; line-height: 1.6; color: rgb(var(--color-text-secondary)); }
  figcaption span { color: rgb(var(--color-primary)); margin-right: .5rem; }
  .zoom-label { position: absolute; right: .75rem; bottom: .75rem; display: inline-flex; align-items: center; gap: .35rem; padding: .4rem .65rem; color: white; background: rgba(0,0,0,.8); border-radius: 5px; font-size: .75rem; }
  .zoom-icon { width: .9rem; height: .9rem; flex: 0 0 auto; }
  :global(html:has(.image-dialog[open])) { overflow: hidden; }
  .image-dialog { margin: auto; padding: 3.5rem 1rem 1rem; width: min(96vw, 1640px); max-height: 95dvh; overscroll-behavior: contain; border: 1px solid rgba(255,255,255,.18); border-radius: 12px; background: rgb(var(--color-bg-dark)); color: rgb(var(--color-text-primary)); }
  .image-dialog::backdrop { background: rgba(0,0,0,.85); }
  .image-dialog img { display: block; max-width: 100%; max-height: 76dvh; height: auto; margin: auto; object-fit: contain; }
  .gallery-close { position: absolute; right: 1rem; top: .4rem; min-height: 44px; padding: .5rem; cursor: pointer; }
  button:focus-visible { outline: 2px solid rgb(var(--color-primary)); outline-offset: 4px; }
</style>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.image-dialog');
  const image = dialog?.querySelector('img');
  const caption = dialog?.querySelector('figcaption');
  const touchLayout = window.matchMedia('(hover: none), (pointer: coarse)');
  document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach(button => button.addEventListener('click', () => {
    const thumbnail = button.querySelector('img');
    if (!dialog || dialog.open || !image || !caption || !thumbnail) return;
    for (const attribute of ['width', 'height']) {
      const value = thumbnail.getAttribute(attribute);
      if (value) image.setAttribute(attribute, value);
      else image.removeAttribute(attribute);
    }
    image.src = touchLayout.matches ? thumbnail.currentSrc || thumbnail.src : thumbnail.src;
    image.alt = thumbnail.alt;
    caption.textContent = image.alt;
    // Safari can leave a tapped button unfocused. Give the dialog a return target.
    button.focus({ preventScroll: true });
    dialog.showModal();
  }));
  dialog?.querySelector('.gallery-close')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => {
    if (!dialog.open) image?.removeAttribute('src');
  });
</script>
