---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../config/copy';
import cat from '../assets/brand/icon.png';

const description = '你要找的頁面不存在。回到首頁，重新出發吧。';
---

<BaseLayout title={`404 — ${copy.error.notFound}`} description={description} currentPath="/404/" hasPointerGlow={false} noindex>
  <section class="lost-page" aria-labelledby="lost-title" data-pagefind-ignore>
    <div class="lost-heading">
      <span class="signal" aria-hidden="true"></span>
      <span>OFF THE MAP</span>
      <span class="issue">ERROR / 404</span>
    </div>

    <div class="lost-art" aria-hidden="true">
      <div class="orbit"></div>
      <div class="orbit orbit-inner"></div>
      <span class="star star-one">+</span>
      <span class="star star-two">+</span>
      <div class="error-number">
        <span>4</span>
        <div class="portal">
          <img class="lost-cat" src={cat.src} width={cat.width} height={cat.height} alt="" />
        </div>
        <span>4</span>
      </div>
      <span class="art-caption">A LITTLE LOST, STILL CURIOUS.</span>
    </div>

    <div class="lost-copy">
      <p class="eyebrow">404 / PAGE NOT FOUND</p>
      <h1 id="lost-title">這一頁，貓也找不到。</h1>
      <p class="description">你要找的頁面不存在。<br />回到首頁，重新出發吧。</p>
      <nav class="lost-actions" aria-label="404 頁面導覽">
        <a class="home-link" href="/">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m12 5-7 7 7 7M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {copy.error.goHome}
        </a>
        <a class="blog-link" href="/blog/">
          閱讀文章
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </nav>
    </div>
    <div class="lost-bottom"><span>HEITANG / EXPLORING EVERY DAY</span><span>換個方向，重新探索</span></div>
  </section>
</BaseLayout>

<style>
  .lost-page {
    width: min(100% - 3rem, 1080px);
    margin-inline: auto;
    padding: 112px 0 28px;
  }

  .lost-heading, .lost-bottom {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 11px / 1.6 'JetBrains Mono', monospace;
    letter-spacing: .12em;
    color: rgb(var(--color-text-secondary));
  }

  .lost-heading { border-bottom: 1px solid rgb(var(--color-primary) / .2); padding-bottom: 18px; }
  .signal { width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--color-primary)); }
  .issue { margin-left: auto; color: rgb(var(--color-primary)); }
  .lost-art { position: relative; display: grid; place-items: center; height: clamp(270px, 32vw, 380px); isolation: isolate; }
  .error-number { display: flex; align-items: center; gap: clamp(12px, 3vw, 40px); font: 700 clamp(132px, 23vw, 260px) / 1 'Inter', sans-serif; letter-spacing: -.07em; color: rgb(var(--color-primary)); }
  .portal { position: relative; width: clamp(112px, 19vw, 210px); height: clamp(146px, 24vw, 264px); border: 1px solid rgb(var(--color-primary) / .65); border-radius: 50%; background: radial-gradient(ellipse at 50% 65%, rgb(var(--color-primary) / .18), rgb(var(--color-primary) / .02) 70%); box-shadow: inset 0 0 45px rgb(var(--color-primary) / .08), 0 0 60px rgb(var(--color-primary) / .05); }
  .lost-cat {
    position: absolute;
    width: 90%;
    max-width: 180px;
    height: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-6deg);
    filter: drop-shadow(0 12px 16px rgb(0 0 0 / .2));
  }
  .orbit { position: absolute; z-index: -1; width: min(88%, 680px); height: 64%; border: 1px solid rgb(var(--color-primary) / .12); border-radius: 50%; transform: rotate(-15deg); }
  .orbit-inner { width: min(73%, 530px); height: 88%; transform: rotate(18deg); border-style: dashed; border-color: rgb(var(--color-primary) / .09); }
  .star { position: absolute; font: 26px / 1 monospace; color: rgb(var(--color-secondary)); }
  .star-one { top: 22%; left: 20%; }
  .star-two { bottom: 22%; right: 17%; font-size: 17px; }
  .art-caption { position: absolute; bottom: 6px; font: 10px / 1.5 'JetBrains Mono', monospace; letter-spacing: .18em; color: rgb(var(--color-text-secondary)); }
  .lost-copy { text-align: center; padding-top: 28px; }
  .eyebrow { font: 11px / 1.5 'JetBrains Mono', monospace; letter-spacing: .2em; color: rgb(var(--color-primary)); margin-bottom: 14px; }
  h1 { font-size: clamp(26px, 4vw, 40px); font-weight: 700; letter-spacing: -.035em; line-height: 1.4; }
  .description { margin-top: 16px; font-size: 15px; line-height: 1.9; color: rgb(var(--color-text-secondary)); }
  .lost-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .lost-actions a { display: inline-flex; justify-content: center; align-items: center; gap: 12px; min-height: 48px; padding: 12px 22px; border-radius: 9px; font-size: 14px; font-weight: 600; transition: background .2s, border-color .2s, color .2s; }
  .lost-actions svg { width: 18px; height: 18px; }
  .home-link { color: rgb(var(--color-bg-dark)); background: rgb(var(--color-primary)); border: 1px solid transparent; }
  .home-link:hover { background: rgb(var(--color-secondary)); }
  .blog-link { border: 1px solid rgb(var(--color-text-secondary) / .3); }
  .blog-link:hover { border-color: rgb(var(--color-primary)); color: rgb(var(--color-primary)); background: rgb(var(--color-primary) / .06); }
  .lost-bottom { justify-content: space-between; margin-top: 64px; padding-top: 20px; border-top: 1px solid rgb(var(--color-primary) / .15); font-size: 10px; }

  @media (max-width: 480px) {
    .lost-page { width: calc(100% - 2.5rem); padding-top: 100px; }
    .lost-art { height: 280px; }
    .star-one { left: 7%; }
    .star-two { right: 6%; }
    .lost-copy { padding-top: 24px; }
    .lost-bottom { margin-top: 44px; flex-direction: column; gap: 8px; }
  }
</style>
