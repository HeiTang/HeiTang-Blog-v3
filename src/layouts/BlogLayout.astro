---
/**
 * BlogLayout — Layout for individual blog posts
 * Liskov Substitution: interchangeable with BaseLayout via consistent props
 */
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/date';
import { siteConfig } from '../config/site';
import { copy } from '../config/copy';
import type { PostMeta } from '../types/blog';
import type { MarkdownHeading } from 'astro';

export interface Props {
  post: PostMeta;
  slug: string;
  readingTime: number;
  relatedPosts: { id: string; data: PostMeta }[];
  headings: MarkdownHeading[];
}

const { post, slug, readingTime, relatedPosts, headings } = Astro.props;
const chapters = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const { blog } = copy;
const { title, description } = post;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonicalUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  datePublished: post.pubDate.toISOString(),
  ...(post.updatedDate && { dateModified: post.updatedDate.toISOString() }),
  author: {
    '@type': 'Person',
    name: post.author,
    ...(post.author === copy.about.name && { url: new URL('/about/', siteConfig.url).toString() }),
  },
  ...(post.cover && { image: new URL(post.cover.src, siteConfig.url).toString() }),
};
---

<BaseLayout
  title={title}
  description={description}
  currentPath="/blog"
  image={post.cover?.src}
  ogType="article"
  structuredData={structuredData}
>
  <!-- OG meta for article -->
  <Fragment slot="head">
    <meta property="article:published_time" content={post.pubDate.toISOString()} />
    {post.updatedDate && <meta property="article:modified_time" content={post.updatedDate.toISOString()} />}
  </Fragment>

  <div class="container mx-auto px-6 py-24 max-w-[45.5rem]">
    <!-- Back link -->
    <a
      href="/blog/"
      class="inline-flex items-center gap-2 text-sm text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-primary))] transition-colors mb-8"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      返回文章列表
    </a>

    <!-- Article header -->
    <header class="mb-10 max-w-3xl">
      <!-- Tags -->
      {post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {post.tags.map(tag => (
            <span class="tag-badge">{tag}</span>
          ))}
        </div>
      )}

      <h1 class="font-display text-3xl md:text-4xl font-bold leading-tight mb-4 text-[rgb(var(--color-text-primary))]">
        {title}
      </h1>

      <p class="text-[rgb(var(--color-text-secondary))] text-lg mb-6">{description}</p>

      <!-- Meta bar -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-[rgb(var(--color-text-secondary))] pb-6 border-b border-[var(--glass-border)]">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {blog.publishedOn} {formatDate(post.pubDate)}
        </span>
        {post.updatedDate && (
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            {blog.updatedOn} {formatDate(post.updatedDate)}
          </span>
        )}
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readingTime} {blog.readingTime}
        </span>
        <span>{post.author}</span>
      </div>
    </header>

    <!-- Article body -->
    <article
      class="prose prose-invert prose-lg max-w-none text-[1.0625rem] leading-[1.75]
        prose-headings:font-display prose-headings:text-[rgb(var(--color-text-primary))] prose-headings:font-bold
        prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl
        prose-p:text-[rgb(var(--color-text-secondary))] prose-p:leading-[1.75] prose-p:my-6
        prose-a:text-[rgb(var(--color-primary))] prose-a:no-underline hover:prose-a:underline prose-a:font-medium
        prose-strong:text-[rgb(var(--color-text-primary))] prose-strong:font-semibold
        prose-em:text-[rgb(var(--color-text-secondary))]
        prose-li:text-[rgb(var(--color-text-secondary))] prose-li:leading-[1.75]
        prose-ul:my-4 prose-ol:my-4
        prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
        prose-pre:border prose-pre:border-[var(--glass-border)] prose-pre:rounded-xl prose-pre:my-6
        prose-blockquote:border-l-4 prose-blockquote:border-[rgb(var(--color-primary))] prose-blockquote:bg-white/[0.03] prose-blockquote:rounded-r-lg prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:text-[rgb(var(--color-text-secondary))] prose-blockquote:not-italic
        prose-hr:border-white/10
        prose-img:rounded-xl prose-img:border prose-img:border-white/10
        prose-table:text-[rgb(var(--color-text-secondary))]
        prose-th:text-[rgb(var(--color-text-primary))] prose-th:border-white/10
        prose-td:border-white/10"
      data-pagefind-body
    >
      <slot />
      {relatedPosts.length > 0 && (
        <nav aria-labelledby="related-posts-heading" data-related-posts>
          <h2 id="related-posts-heading">延伸閱讀</h2>
          <ul>
            {relatedPosts.map(related => (
              <li><a href={`/blog/${related.id}/`}>{related.data.title}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </article>
    {chapters.length > 0 && (
      <>
        <button class="toc-toggle" type="button" popovertarget="blog-toc" aria-label="開啟章節目錄" aria-expanded="false" aria-controls="blog-toc">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1" />
          </svg>
        </button>
        <nav id="blog-toc" class="blog-toc" popover="auto" aria-labelledby="blog-toc-title" data-pagefind-ignore>
          <div class="toc-header">
            <h2 id="blog-toc-title">章節</h2>
            <button class="toc-close" type="button" popovertarget="blog-toc" popovertargetaction="hide" aria-label="關閉章節目錄">×</button>
          </div>
          <ol>
            {chapters.map(heading => (
              <li class:list={{ 'toc-subheading': heading.depth === 3 }} hidden={heading.depth === 3}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </>
    )}
  </div>
</BaseLayout>

<style>
  article { min-width: 0; }
  article :global([id]) { scroll-margin-top: 6rem; }

  .blog-toc {
    position: fixed;
    inset: auto 1.5rem calc(9.5rem + env(safe-area-inset-bottom)) auto;
    margin: 0;
    width: min(20rem, calc(100vw - 3rem));
    max-height: min(65dvh, calc(100dvh - 12rem));
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    background: rgb(var(--color-bg-dark));
    color: rgb(var(--color-text-secondary));
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.25);
    font-size: 0.875rem;
  }

  .blog-toc::backdrop { background: rgb(0 0 0 / 0.25); }
  .toc-header { display: flex; align-items: center; justify-content: space-between; }
  .toc-header h2 { font-weight: 600; color: rgb(var(--color-text-primary)); }
  .toc-close { width: 2.75rem; height: 2.75rem; font-size: 1.5rem; }
  .blog-toc a { display: block; padding: 0.75rem 0.5rem; border-left: 2px solid transparent; overflow-wrap: anywhere; }
  .blog-toc a:hover { color: rgb(var(--color-text-primary)); }
  .blog-toc a[aria-current] { color: rgb(var(--color-primary)); border-left-color: currentColor; background: rgb(var(--color-primary) / 0.06); }
  .blog-toc a:focus-visible, .toc-toggle:focus-visible, .toc-close:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .toc-subheading { padding-left: 0.75rem; }
  .toc-toggle {
    position: fixed;
    right: 1.5rem;
    bottom: calc(6rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: rgb(var(--color-bg-dark));
    color: rgb(var(--color-text-primary));
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
  }

  @media (min-width: 1440px) {
    .toc-toggle, .toc-close { display: none; }
    .blog-toc {
      display: block;
      inset: 8rem auto auto calc(50% + 24.25rem);
      width: min(15rem, calc(50vw - 25.75rem));
      max-height: calc(100dvh - 10rem);
      padding: 0 0.25rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .toc-header { margin-bottom: 0.75rem; }
    .blog-toc a { padding-block: 0.5rem; }
  }

  :global([data-theme="minimalist"]) article :global(a) {
    color: rgb(var(--color-text-primary));
    text-decoration: underline;
  }

  article :global(:not(pre) > code) {
    color: rgb(var(--color-text-primary));
    background: var(--glass-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    overflow-wrap: anywhere;
  }

  /* Keep Shiki's foreground and background together, including plain code. */
  article :global(pre > code) {
    color: inherit;
    background: transparent;
    padding: 0;
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('#blog-toc');
  const toggle = document.querySelector<HTMLButtonElement>('.toc-toggle');
  if (toc && toggle) {
    const desktop = matchMedia('(min-width: 1440px)');
    const setMode = () => {
      if (toc.matches(':popover-open')) toc.hidePopover();
      if (desktop.matches) toc.removeAttribute('popover');
      else toc.setAttribute('popover', 'auto');
      toggle.setAttribute('aria-expanded', 'false');
    };
    setMode();
    desktop.addEventListener('change', setMode);
    toc.addEventListener('toggle', () => {
      toggle.setAttribute('aria-expanded', String(toc.matches(':popover-open')));
    });
    toc.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('a') && toc.matches(':popover-open')) toc.hidePopover();
    });
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const sections = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    let parent = 0;
    const groups = sections.map((section, index) => {
      if (section?.tagName === 'H2') parent = index;
      return parent;
    });
    const updateChapter = () => {
      let active = 0;
      sections.forEach((section, index) => {
        if (section && section.getBoundingClientRect().top <= 140) active = index;
      });
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) active = links.length - 1;
      links.forEach((link, index) => {
        link.parentElement!.hidden = sections[index]?.tagName === 'H3' && groups[index] !== groups[active];
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (desktop.matches) {
        const item = links[active].getBoundingClientRect();
        const panel = toc.getBoundingClientRect();
        if (item.top < panel.top) toc.scrollTop += item.top - panel.top;
        else if (item.bottom > panel.bottom) toc.scrollTop += item.bottom - panel.bottom;
      }
    };
    let scheduled = false;
    window.addEventListener('scroll', () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { updateChapter(); scheduled = false; });
    }, { passive: true });
    window.addEventListener('resize', updateChapter);
    updateChapter();
  }
</script>
